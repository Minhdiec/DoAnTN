# ---------------------------------------------------------------------------
# File mẫu cấu hình biến môi trường.
#
# CÁCH DÙNG: sao chép file này thành một file mới tên là ".env" (nằm cùng
# cấp với manage.py), rồi điền các giá trị thật của máy bạn vào. File
# ".env" đã được liệt kê sẵn trong .gitignore nên sẽ KHÔNG bị đẩy lên Git,
# tránh lộ mật khẩu database ra bên ngoài.
# ---------------------------------------------------------------------------

# Khóa bí mật của Django, dùng để mã hóa session/CSRF token. Khi triển khai
# thật, hãy tạo một chuỗi ngẫu nhiên dài, không dùng lại giá trị mặc định.
DJANGO_SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-ngau-nhien

# True khi đang phát triển trên máy cá nhân, False khi triển khai thật.
DJANGO_DEBUG=True

# Danh sách domain/IP được phép truy cập, cách nhau bởi dấu phẩy.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Thông tin kết nối MySQL ---
# Trước khi chạy migrate, phải tạo sẵn database rỗng bằng lệnh MySQL:
#   CREATE DATABASE astraea_eyewear_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_NAME=astraea_eyewear_db
DB_USER=root
DB_PASSWORD=mat_khau_mysql_cua_ban
DB_HOST=127.0.0.1
DB_PORT=3306
